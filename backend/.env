# Database Configuration
# Default: SQLite (praktis, siap jalan langsung)
# Untuk menggunakan MySQL/XAMPP ganti DB_CONNECTION=mysql
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=absensi_sekolah
